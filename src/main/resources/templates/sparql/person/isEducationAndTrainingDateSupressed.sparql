PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX vivo: <http://vivoweb.org/ontology/core#>
 
CONSTRUCT {
    ?isDateSupressed vivo:supplementalInformation ?isDateSupressedWithId .
} WHERE {
    <{{uri}}> obo:RO_0000056 ?training .
    ?training vivo:dateTimeInterval ?dateTimeInterval .
    ?dateTimeInterval vivo:supplementalInformation ?isDateSupressed .
    BIND( CONCAT( STR(?isDateSupressed), REPLACE(STR(?training), "(^.*/)", "::") ) AS ?isDateSupressedWithId ) .
}